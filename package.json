{
  "name": "mesai-defteri",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "build:ios": "npm run build && cap sync ios",
    "cap:sync": "npm run build && cap sync",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "node scripts/check-calc.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
